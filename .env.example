# Modelo fictício. Copie para .env e substitua o token de senha por um valor
# alfanumérico aleatório local. Repita exatamente a mesma senha na DATABASE_URL.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:8443
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_ALEATORIA_LOCAL
DATABASE_URL=postgresql://fineduca:SUBSTITUA_POR_SENHA_ALEATORIA_LOCAL@127.0.0.1:5432/fineduca?schema=public
SESSION_TTL_HOURS=168
